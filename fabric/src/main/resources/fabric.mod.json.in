{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/craftingtable-ii-refabricated",
        "sources": "https://github.com/johnpgr/craftingtableii-refabricated",
        "issues": "https://github.com/johnpgr/craftingtableii-refabricated/issues"
    },
    "license": "${license}",
    "icon": "assets/craftingtableiifabric/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "net.johnpgr.craftingtableiifabric.CraftingTableIIMod"
        ],
        "client": [
            "net.johnpgr.craftingtableiifabric.CraftingTableIIModClient"
        ]
    },
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": ${minecraft_targets},
        "java": ">=${java_version}"
    }
}
